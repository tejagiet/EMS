# =============================================================================
# GIET POLYTECHNIC COLLEGE - EMPLOYEE MANAGEMENT SYSTEM (EMS)
# Monorepo .gitignore - Optimized for GitHub (< 100 MB Strict Limit)
# =============================================================================

# ── Dependencies ─────────────────────────────────────────────────────────────
node_modules/
**/node_modules/
.pnp
.pnp.js

# ── Monorepo Build Outputs & Distribution ────────────────────────────────────
dist/
**/dist/
build/
**/build/
out/
**/out/
web-dist/
**/web-dist/
.next/
**/.next/
.expo/
**/.expo/
.expo-shared/
**/.expo-shared/
target/
src-tauri/target/
.turbo/
**/.turbo/
.vercel/
**/.vercel/
.cache/
**/.cache/
*.tsbuildinfo

# ── Large Binary Files & Packages (GitHub 100MB Block Rule) ──────────────────
*.apk
*.aab
*.exe
!apps/web/public/downloads/*.exe
*.msi
*.dmg
*.pkg
*.deb
*.rpm
*.iso
*.bin
*.so
*.dex
*.pack
*.pack.old
*.pack.gz
*.zip
*.tar
*.tar.gz
*.tgz
*.7z
*.rar

# ── Android & Gradle Specific Artifacts ──────────────────────────────────────
.gradle/
**/.gradle/
**/android/app/build/
**/android/build/
**/android/.gradle/
local.properties
*.iml
.idea/

# ── Mobile Keystores & Credentials ───────────────────────────────────────────
*.jks
*.keystore
*.p8
*.p12
*.key
*.pem
*.mobileprovision
google-services.json
GoogleService-Info.plist
secrets/

# ── Environment & Secrets ────────────────────────────────────────────────────
.env
.env.local
.env.*.local
.env.development.local
.env.test.local
.env.production.local
!.env.example

# ── System & OS Files ─────────────────────────────────────────────────────────
.DS_Store
Thumbs.db
Desktop.ini
*.swp
*.swo
*.suo
*.ntvs*
*.njsproj
*.sln
.vscode/*
!.vscode/extensions.json

# ── Logs & Debugging ─────────────────────────────────────────────────────────
*.log
npm-debug.log*
pnpm-debug.log*
yarn-debug.log*
yarn-error.log*

# ── Test Coverage ────────────────────────────────────────────────────────────
coverage/
**/coverage/
.nyc_output/

# ── Supabase Generated ───────────────────────────────────────────────────────
supabase/.branches/
supabase/.temp/
