{
  "name": "@ems/desktop",
  "version": "1.0.0",
  "private": true,
  "description": "EMS Windows Desktop Application - GIET Polytechnic College AI Department",
  "author": "GIET Polytechnic College · AI Department · Team T-1",
  "main": "main.js",
  "scripts": {
    "dev": "electron .",
    "start": "electron .",
    "build": "electron-builder --win",
    "pack": "electron-builder --dir",
    "dist": "electron-builder --win",
    "dist:nsis": "electron-builder --win nsis",
    "dist:portable": "electron-builder --win portable",
    "clean": "rimraf dist"
  },
  "build": {
    "appId": "in.gietpoly.ems",
    "productName": "EMS Desktop",
    "copyright": "Copyright © 2026 GIET Polytechnic College · AI Department · Team T-1",
    "directories": {
      "output": "dist"
    },
    "afterPack": "./scripts/afterPack.js",
    "files": [
      "main.js",
      "preload.js",
      "connecting.html",
      "splash.html",
      "web-dist/**/*",
      "!web-dist/**/*.map",
      "logo.jpg",
      "icon.png",
      "icon.ico"
    ],
    "compression": "maximum",
    "win": {
      "target": [
        "nsis"
      ],
      "icon": "icon.ico",
      "legalTrademarks": "GIET Polytechnic College (GIETP-AI-IT-EMS-T1-2026)"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "EMS Desktop",
      "artifactName": "EMS-Desktop-Setup-${version}.${ext}"
    }
  },
  "dependencies": {
    "@ems/config": "workspace:*",
    "@ems/shared": "workspace:*",
    "@ems/types": "workspace:*",
    "@ems/ui": "workspace:*"
  },
  "devDependencies": {
    "concurrently": "^10.0.6",
    "electron": "^44.9.0",
    "electron-builder": "^26.15.3",
    "rimraf": "^6.0.0",
    "typescript": "^5.5.0",
    "wait-on": "^9.5.1"
  }
}
