{
  "$schema": "https://json.schemastore.org/tsconfig",
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "target": "ES2020",
    "lib": ["DOM", "DOM.Iterable", "ES2022"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "allowJs": true,
    "declaration": false,
    "declarationMap": false,
    "composite": false,
    "noUnusedLocals": false,
    "noUnusedParameters": false,
    "exactOptionalPropertyTypes": false,
    "types": ["vite/client", "node"],
    "outDir": "./dist",
    "rootDir": ".",
    "noEmit": true,
    "paths": {
      "@/*": ["./*"],
      "next/navigation": ["./lib/next-compat/navigation.ts"],
      "next/link": ["./lib/next-compat/link.tsx"],
      "next/cache": ["./lib/next-compat/cache.ts"],
      "next/headers": ["./lib/next-compat/headers.ts"],
      "next/server": ["./lib/next-compat/server.ts"]
    }
  },
  "include": ["src/**/*", "app/**/*", "components/**/*", "lib/**/*"],
  "exclude": ["node_modules", "dist", ".next", "out"]
}
