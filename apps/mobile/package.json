{
  "name": "@ems/mobile",
  "version": "0.1.0",
  "private": true,
  "description": "EMS Expo Android mobile application",
  "main": "index.js",
  "scripts": {
    "dev": "expo start",
    "android": "expo run:android",
    "build": "expo export --platform android --output-dir dist",
    "build:eas": "eas build --platform android",
    "expo:prebuild": "expo prebuild",
    "lint": "eslint . --ext .ts,.tsx",
    "lint:fix": "eslint . --ext .ts,.tsx --fix",
    "typecheck": "tsc --noEmit",
    "clean": "rimraf .expo android/build ios/build dist",
    "ios": "expo run:ios"
  },
  "dependencies": {
    "@babel/runtime": "^8.0.7",
    "@ems/config": "workspace:*",
    "@ems/shared": "workspace:*",
    "@ems/types": "workspace:*",
    "@ems/validation": "workspace:*",
    "@expo/vector-icons": "^15.1.1",
    "@supabase/supabase-js": "^2.117.3",
    "expo": "~52.0.0",
    "expo-asset": "~11.0.5",
    "expo-constants": "~17.0.8",
    "expo-file-system": "~18.0.12",
    "expo-font": "~13.0.4",
    "expo-keep-awake": "~14.0.3",
    "expo-linking": "~7.0.5",
    "expo-router": "~4.0.0",
    "expo-status-bar": "~2.0.0",
    "query-string": "^9.5.1",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "react-native": "0.76.6",
    "react-native-safe-area-context": "5.10.1",
    "react-native-screens": "~4.4.0"
  },
  "devDependencies": {
    "@babel/core": "^7.24.0",
    "@types/react": "~18.3.0",
    "rimraf": "^6.0.0",
    "typescript": "^5.5.0"
  }
}
