{
  "name": "@ems/shared",
  "version": "0.1.0",
  "private": true,
  "description": "Shared utilities and helpers for the EMS monorepo",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc --project tsconfig.json",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src --ext .ts,.tsx",
    "lint:fix": "eslint src --ext .ts,.tsx --fix",
    "clean": "rimraf dist"
  },
  "devDependencies": {
    "@ems/types": "workspace:*",
    "rimraf": "^6.0.0",
    "typescript": "^5.5.0"
  },
  "files": ["dist", "src"]
}
