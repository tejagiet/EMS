# ─────────────────────────────────────────────────────────────────────────────
# EMS — Environment Variable Template
# Copy this file to .env.local (never commit .env.local)
# ─────────────────────────────────────────────────────────────────────────────

# ── Supabase ──────────────────────────────────────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=https://<your-project-id>.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=<your-anon-key>
SUPABASE_SERVICE_ROLE_KEY=<your-service-role-key>  # Server-side only, never expose to client
SUPABASE_DB_PASSWORD=<your-db-password>

# ── Next.js Web App ───────────────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_APP_NAME=Employee Management System

# ── Expo Mobile App ───────────────────────────────────────────────────────────
EXPO_PUBLIC_SUPABASE_URL=https://<your-project-id>.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=<your-anon-key>
EXPO_PUBLIC_APP_NAME=EMS Mobile

# ── Tauri Desktop App ─────────────────────────────────────────────────────────
TAURI_PRIVATE_KEY=<your-tauri-signing-private-key>
TAURI_KEY_PASSWORD=<your-tauri-key-password>

# ── General ───────────────────────────────────────────────────────────────────
NODE_ENV=development
