# ─────────────────────────────────────────────────────────────────────────────
# EMS — Environment Variable Template
# Copy this file to .env.local (never commit .env.local)
# Project: GIETP-AI-IT-EMS-T1-2026
# ─────────────────────────────────────────────────────────────────────────────

# ── Supabase Local Development (supabase start) ───────────────────────────────
# These values are auto-generated by `supabase start` for local dev.
# Run `pnpm db:status` after starting to see your local values.
SUPABASE_LOCAL_URL=http://127.0.0.1:54321
SUPABASE_LOCAL_ANON_KEY=<output of: pnpm db:status>
SUPABASE_LOCAL_SERVICE_ROLE_KEY=<output of: pnpm db:status>
SUPABASE_LOCAL_DB_URL=postgresql://postgres:postgres@127.0.0.1:54322/postgres

# ── Supabase Production / Staging ─────────────────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=https://<your-project-id>.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=<your-anon-key>
SUPABASE_SERVICE_ROLE_KEY=<your-service-role-key>   # Server-side only — never expose to client
SUPABASE_DB_PASSWORD=<your-db-password>
SUPABASE_PROJECT_ID=<your-project-id>

# ── Next.js Web App ───────────────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_APP_NAME=Employee Management System

# ── Expo Mobile App ───────────────────────────────────────────────────────────
EXPO_PUBLIC_SUPABASE_URL=https://<your-project-id>.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=<your-anon-key>
EXPO_PUBLIC_APP_NAME=EMS Mobile

# ── Tauri Desktop App ─────────────────────────────────────────────────────────
TAURI_PRIVATE_KEY=<your-tauri-signing-private-key>
TAURI_KEY_PASSWORD=<your-tauri-key-password>

# ── General ───────────────────────────────────────────────────────────────────
NODE_ENV=development
